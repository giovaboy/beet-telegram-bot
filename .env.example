# Environment template for beet-telegram-bot
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored and excluded from the Docker image: never commit real tokens.

# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=1234567890

# Beets container
BEET_CONTAINER=beets
BEET_USER=abc

# Host paths mounted by beet-telegram-bot.yml
MUSIC_LIBRARY=/path/to/music
MUSIC_DOWNLOADS=/path/to/downloads

# Docker
PUID=1000              # owner of the downloads folder: id -u
PGID=1000              # its group: id -g
TZ=Europe/Rome
DOCKER_GID=999         # group owning the Docker socket: stat -c '%g' /var/run/docker.sock
